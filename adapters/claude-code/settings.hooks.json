{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/skills/context-slim/adapters/claude-code/hooks/context_monitor.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/skills/context-slim/adapters/claude-code/hooks/bash_guard.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/skills/context-slim/adapters/claude-code/hooks/read_guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/skills/context-slim/adapters/claude-code/hooks/dispatch_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/skills/context-slim/adapters/claude-code/hooks/context_monitor.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/skills/context-slim/adapters/claude-code/hooks/context_monitor.py\""
          }
        ]
      }
    ]
  }
}
